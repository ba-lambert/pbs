# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-strong-secret

# Allowed CORS origins (JSON array, must match your frontend domain)
# Since nginx proxies /api/ to the backend, CORS isn't strictly required
# but set it to your domain anyway
CORS_ORIGINS=["https://yourdomain.com","http://yourdomain.com"]

# Port the frontend nginx listens on (default 80)
CLIENT_PORT=80

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Email — used to send driver welcome emails with temporary passwords
# For Gmail: enable 2FA then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=PBS Platform
